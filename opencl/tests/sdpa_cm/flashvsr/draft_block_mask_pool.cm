// Stage 1 of DraftBlockMask (FlashVSR's generate_draft_block_mask, wan_video_dit.py:116-153):
// mean-pool a windowed [N, WINDOW_TOKENS, NUM_HEADS*HEAD_DIM] half (or, with K_CACHE_COMPRESSION,
// int8-packed) tensor over the WINDOW_TOKENS dim, per head -> pooled [N(+out_row_offset),
// NUM_HEADS, HEAD_DIM] half. Bandwidth-bound: reads the full windowed Q/K, same order of bytes as
// the main attention op itself. The same kernel entry point is used for both Q and K, bound to
// different input/output buffers and dispatch sizes by the host (see DraftBlockMaskPoolGenerator
// in draft_block_mask.cpp).
//
// JIT constants: NUM_HEADS, HEAD_DIM, WINDOW_TOKENS, K_CACHE_COMPRESSION (default 0),
// HAS_OUT_ROW_OFFSET (default 0)
// GWS: [N, NUM_HEADS, 1], LWS: [1,1,1].
//
// HAS_OUT_ROW_OFFSET: when set, an extra runtime `out_row_offset` arg shifts every write's row
// index by a constant -- lets a dual-source caller (K-cache then K-cur) pool both sources straight
// into two slices of ONE shared device `pooled` buffer (cache dispatch at offset 0, cur dispatch at
// offset num_cache_windows) instead of pooling into two separate buffers and stitching them
// together on the host. Purely an output-addressing change -- independent of K_CACHE_COMPRESSION
// (which only affects how `windowed` is read).
//
// K_CACHE_COMPRESSION (0=NONE, 1=BY_TOKEN, 2=BY_CHANNEL, matching pageatten/test_pa.py's
// KV_CACHE_COMPRESSION_{NONE,BY_TOKEN,BY_CHANNEL} enum/JIT-constant convention): this project's
// cache K/V may be stored int8-packed (1 byte/element, affine uint8 quantization -- see
// cm_int8_kv_decode.hpp) to save device memory; Q is never quantized (only cache K/V ever is, see
// the BlockSparseAttention int8-cache work this mirrors), so this flag only ever applies to a
// K-pooling dispatch -- the host picks which compiled kernel variant (K_CACHE_COMPRESSION=0/1/2) to
// bind to which buffer, same mechanism that already lets this one kernel source serve both Q- and
// K-pooling. When set, `windowed` is int8-packed uchar instead of half, plus `k_scale`/`k_zp`
// tensors carry the dequant scale/zero-point (see int8_kv_ref.py, the host-side encode reference).
// Quantization treats this kernel's whole D_full=NUM_HEADS*HEAD_DIM axis as one flat "channel" set
// (the windowed buffer has no separate per-head leading dim in memory), so BY_CHANNEL's scale/zp
// are [num_k_windows, WINDOW_TOKENS/16, D_full] and BY_TOKEN's are [num_k_windows, WINDOW_TOKENS]
// (one scalar per token, shared across every channel) -- a given (window,head) dispatch reads its
// own HEAD_DIM-wide slice of the D_full-wide BY_CHANNEL scale/zp, exactly mirroring how it already
// reads its own HEAD_DIM-wide slice of the raw D_full-wide windowed data. `pooled` (the output)
// stays half unconditionally either way -- only the input side changes. No SLM/barrier work is
// needed here (GWS=[N,NUM_HEADS,1], LWS=[1,1,1] -- no sibling lanes to cooperate with), just a flat
// per-row affine decode -- a strict improvement over the retired LUT-gather decode this replaces,
// which was the single worst-performing decode pattern in this codebase (no lane-sharing
// opportunity here at all, and it didn't even get the SLM-staged LUT amortization sdpa_kernel_lsc's
// quantized-KV path had).
//
#include <cm/cm.h>
#include <cm/cmtl.h>
#include "cm_int8_kv_decode.hpp"

#ifndef ATTR
#define ATTR [[type("svmptr_t")]]
#endif

#ifndef K_CACHE_COMPRESSION
#define K_CACHE_COMPRESSION 0
#endif

#ifndef HAS_OUT_ROW_OFFSET
#define HAS_OUT_ROW_OFFSET 0
#endif

extern "C" _GENX_MAIN_ void KERNEL_NAME(
#if K_CACHE_COMPRESSION
    uchar* windowed ATTR,
    half* k_scale ATTR,
    half* k_zp ATTR,
#else
    half* windowed ATTR,
#endif
    half* pooled ATTR
#if HAS_OUT_ROW_OFFSET
    , uint out_row_offset
#endif
    ) {
    constexpr uint D_full = NUM_HEADS * HEAD_DIM;
    uint w = cm_group_id(0);
    uint h = cm_group_id(1);

    uint row_base_elems = w * (uint)WINDOW_TOKENS * D_full + h * (uint)HEAD_DIM;

    vector<float, HEAD_DIM> acc = 0;
#if K_CACHE_COMPRESSION == 2
    // BY_CHANNEL: reselect this (window, head)'s HEAD_DIM-wide scale/zp slice once per 16-token
    // sub-block boundary (not every token) -- same "reload every 16 tokens" cadence
    // cm_sdpa_common.hpp's sdpa_accumulate_kv_source_slm uses for its own BY_CHANNEL K path.
    constexpr int SUB_BLOCK = 16;
    static_assert(WINDOW_TOKENS % SUB_BLOCK == 0, "WINDOW_TOKENS must be divisible by 16 for BY_CHANNEL pooling");
    constexpr int num_sub_blocks = WINDOW_TOKENS / SUB_BLOCK;
    uint meta_base = (w * (uint)num_sub_blocks) * D_full + h * (uint)HEAD_DIM;
    for (int sb = 0; sb < num_sub_blocks; sb++) {
        vector<half, HEAD_DIM> scale, zp;
        uint meta_off = meta_base + (uint)sb * D_full;
        scale.format<int>() = cm_ptr_load<int, HEAD_DIM / 2>((int*)k_scale, meta_off * (uint)sizeof(half));
        zp.format<int>() = cm_ptr_load<int, HEAD_DIM / 2>((int*)k_zp, meta_off * (uint)sizeof(half));
#    pragma unroll
        for (int tt = 0; tt < SUB_BLOCK; tt++) {
            uint t = (uint)(sb * SUB_BLOCK + tt);
            vector<uchar, HEAD_DIM> raw_row;
            raw_row.format<int>() =
                cm_ptr_load<int, HEAD_DIM / 4>((int*)windowed, (row_base_elems + t * D_full) * (uint)sizeof(uchar));
            vector<half, HEAD_DIM> row;
            int8_decode_by_channel_row<HEAD_DIM>(raw_row, scale, zp, row);
            acc += row;
        }
    }
#elif K_CACHE_COMPRESSION == 1
    // BY_TOKEN: one scalar (scale,zp) pair per token, shared across every channel -- read fresh
    // every token (cheap, a single half each, no vector).
    for (uint t = 0; t < WINDOW_TOKENS; t++) {
        half scale = k_scale[w * (uint)WINDOW_TOKENS + t];
        half zp = k_zp[w * (uint)WINDOW_TOKENS + t];
        vector<uchar, HEAD_DIM> raw_row;
        raw_row.format<int>() =
            cm_ptr_load<int, HEAD_DIM / 4>((int*)windowed, (row_base_elems + t * D_full) * (uint)sizeof(uchar));
        vector<half, HEAD_DIM> row = raw_row - zp;
        row = cm_mul<half>(row, scale);
        acc += row;
    }
#else
    for (uint t = 0; t < WINDOW_TOKENS; t++) {
        vector<half, HEAD_DIM> row;
        row.format<int>() = cm_ptr_load<int, HEAD_DIM / 2>((int*)windowed, (row_base_elems + t * D_full) * (uint)sizeof(half));
        acc += row;
    }
#endif
    vector<half, HEAD_DIM> out = acc * (1.0f / (float)WINDOW_TOKENS);

#if HAS_OUT_ROW_OFFSET
    uint out_row = w + out_row_offset;
#else
    uint out_row = w;
#endif
    uint out_off_elems = (out_row * (uint)NUM_HEADS + h) * (uint)HEAD_DIM;
    cm_ptr_store<int, HEAD_DIM / 2>((int*)pooled, out_off_elems * (uint)sizeof(half), out.format<int>());
}
