//
// Stage 3/4 of FlashVSR's generate_draft_block_mask (see flashvsr_draft_gemm.cm's header for
// stages 1/2):
//   flashvsr_softmax    -- row-wise softmax of flashvsr_draft_gemm.cm's raw (local-masked)
//                          scores -> half probabilities (half chosen so the top-k step below can
//                          treat each value's raw bit pattern as a monotonic sort key directly).
//   flashvsr_topk_mask  -- the part that differs fundamentally from X-Attention's
//                          xattn_find_block.cm: a GLOBAL top-k over the flattened
//                          (spatial_windows * num_k_windows) elements of one
//                          (head, Q-temporal-group), not a per-row threshold.
//
// Deliberate deviation from the original plan: rather than reusing x_attn/sort.hpp's radix
// `sort<half>` (whose index arrays are `ushort`, capped at 65535), this finds the top-k
// threshold via a binary search on the fp16 raw bit pattern (softmax outputs are always >= 0,
// so IEEE754 bit pattern order already matches value order for the range actually produced here
// -- no half<->sortable-uint transform needed): each of ~15 iterations counts how many elements
// exceed a candidate bit-pattern threshold, converging on the exact (topk+1)-th-largest value,
// exactly like generate_draft_block_mask's `torch.topk(...).values[:,-1]`. FlashVSR's own
// production scale (warm-up chunk: spatial_windows=150 * num_k_windows=450 = 67500 elements per
// group) exceeds sort.hpp's ushort index range, which the binary-search approach has no bound on
// (only extra read passes, not a correctness ceiling) -- see the implementation plan's Stage 2
// note for the analysis that motivated this switch.
//
#include <cm/cm.h>
#include <cm/cmtl.h>

#ifndef ATTR
#define ATTR [[type("svmptr_t")]]
#endif

namespace KERNEL_NAME {

#ifndef NUM_HEADS
#define NUM_HEADS 12
#endif

// raw_scores: [NUM_HEADS, num_q_windows, num_k_windows] float (flashvsr_score's output).
// probs:      [NUM_HEADS, num_q_windows, num_k_windows] half (softmax output; always >= 0).
// GWS: [num_q_windows, NUM_HEADS, 1], LWS: [1,1,1].
extern "C" _GENX_MAIN_ void flashvsr_softmax(
    float* raw_scores ATTR,
    half* probs ATTR,
    int num_k_windows) {
    constexpr float log2e = 1.4426950408889634f;
    uint l = cm_group_id(0);
    uint h = cm_group_id(1);
    uint row_off = (h * (uint)cm_group_count(0) + l) * (uint)num_k_windows;

    float row_max = -3.0e38f;
    for (int m = 0; m < num_k_windows; m++) {
        float v = raw_scores[row_off + (uint)m];
        row_max = cm_max<float>(row_max, v);
    }

    float sum = 0.0f;
    for (int m = 0; m < num_k_windows; m++) {
        float v = raw_scores[row_off + (uint)m];
        float e = cm_exp((v - row_max) * log2e); // cm_exp == exp2, so this is exp(v - row_max)
        sum += e;
        raw_scores[row_off + (uint)m] = e;
    }

    float inv_sum = 1.0f / sum;
    for (int m = 0; m < num_k_windows; m++) {
        float e = raw_scores[row_off + (uint)m];
        probs[row_off + (uint)m] = (half)(e * inv_sum);
    }
}

#ifndef TOPK_LOCAL_SIZE
#define TOPK_LOCAL_SIZE 32
#endif

// probs: [NUM_HEADS, num_q_windows, num_k_windows] half, num_q_windows == num_groups*spatial_windows.
// mask_out: [NUM_HEADS, num_q_windows, num_k_windows] bool/uint8, 1=keep 0=skip -- directly the
//   ABI cm_sdpa_opt_prefill.cm's SPARSE_BLOCK_SIZE=128 sparse_block_mask expects (B=1 always,
//   FlashVSR's own hard assertion).
// GWS: [NUM_HEADS, num_groups, TOPK_LOCAL_SIZE], LWS: [1,1,TOPK_LOCAL_SIZE]. Each WORKGROUP owns
//   one contiguous spatial_windows*num_k_windows slice of probs (rows
//   [g*spatial_windows,(g+1)*spatial_windows) of head h) -- contiguous because probs is row-major
//   over (h, l, m) and a temporal group is a contiguous run of l. The TOPK_LOCAL_SIZE work items
//   within that workgroup split the slice's n elements (strided) and cooperatively binary-search
//   the top-k threshold via an SLM partial-count reduction each of the ~16 iterations --
//   parallelizes the single-thread-per-group binary search that otherwise leaves this kernel
//   using a tiny fraction of the GPU's EUs (measured ~72ms/call at FlashVSR's warm-up-chunk scale
//   with TOPK_LOCAL_SIZE=1; see bench_flashvsr_mask.py).
extern "C" _GENX_MAIN_ void flashvsr_topk_mask(
    half* probs ATTR,
    uchar* mask_out ATTR,
    int num_q_windows,
    int num_k_windows,
    int spatial_windows,
    int topk) {
    constexpr uint LOCAL_SIZE = TOPK_LOCAL_SIZE;
    uint h = cm_group_id(0);
    uint g = cm_group_id(1);
    uint lid = cm_local_id(2);

    const uint slm_size = (LOCAL_SIZE + 1) * (uint)sizeof(int);
    cm_slm_init(slm_size);
    auto slm = cm_slm_alloc(slm_size);

    uint n = (uint)spatial_windows * (uint)num_k_windows;
    uint base_off = (h * (uint)num_q_windows + g * (uint)spatial_windows) * (uint)num_k_windows;

    int apply_topk = topk;
    if (apply_topk > (int)n - 1) apply_topk = (int)n - 1;
    if (apply_topk < 0) apply_topk = 0;

    // Softmax outputs are always in [0,1] (non-negative finite half), so their raw bit pattern,
    // compared as an unsigned integer, already preserves value order -- no half<->sortable-uint
    // sign-flip transform needed (that's only required for values that can be negative).
    ushort* probs_bits = (ushort*)probs;
    ushort lo = 0;
    ushort hi = 0x7fff;
    for (int iter = 0; iter < 16; iter++) {
        ushort mid = lo + (hi - lo) / 2;
        int local_count = 0;
        for (uint i = lid; i < n; i += LOCAL_SIZE) {
            if (probs_bits[base_off + i] > mid) local_count++;
        }
        vector<int, 1> lc = local_count;
        cm_slm_block_write(slm, lid * (uint)sizeof(int), lc.format<int>());
        cm_barrier();

        if (lid == 0) {
            vector<int, LOCAL_SIZE> all;
            cm_slm_block_read(slm, 0, all.format<int>());
            vector<int, 1> total = cm_sum<int>(all);
            cm_slm_block_write(slm, LOCAL_SIZE * (uint)sizeof(int), total.format<int>());
        }
        cm_barrier();

        vector<int, 1> total_v;
        cm_slm_block_read(slm, LOCAL_SIZE * (uint)sizeof(int), total_v.format<int>());
        int count = total_v[0];
        if (count > apply_topk) lo = mid + 1; else hi = mid;
        cm_barrier();
    }
    ushort threshold_bits = lo;

    for (uint i = lid; i < n; i += LOCAL_SIZE) {
        mask_out[base_off + i] = (probs_bits[base_off + i] > threshold_bits) ? 1 : 0;
    }
}

}  // namespace KERNEL_NAME
