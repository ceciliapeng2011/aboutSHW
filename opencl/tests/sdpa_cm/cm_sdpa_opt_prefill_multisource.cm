//
// Two-source (ring + current) block-sparse SDPA prefill kernel: the CM-kernel mirror of the real
// OpenVINO BlockSparseAttention primitive's `input[1]=key_cache.<layer>` (ring, persistent) +
// `input[2]=k_new_f16` (current, this chunk's own new K/V) ABI -- see
// flashvsr_dit_kvcache_int8_3slot_fused_multisource_design_zh.md Sec 3.3/10.4. Ring and current
// are two INDEPENDENT device buffers, never concatenated by host or kernel; the inner tile loop
// (sdpa_kernel_lsc_prefetch_2src, in cm_sdpa_common.hpp) visits ring's tiles then current's tiles
// against one shared pair of online-softmax accumulators, which is numerically equivalent to one
// pass over concat(key_ring, key_cur).
//
// Deliberately narrower than cm_sdpa_opt_prefill.cm: no causal mask, no dense additive attn_mask,
// SPARSE_BLOCK_SIZE is always required (>1) -- FlashVSR's own self-attention never needs the first
// two, and a dual-source *dense* kernel has no behavior distinguishing it from the existing
// single-source one worth testing separately. See cm_sdpa_common.hpp's sdpa_accumulate_kv_source
// file-header comment for the full rationale.
//
// Q_TRANSPOSE_ORDER/K_TRANSPOSE_ORDER/V_TRANSPOSE_ORDER/OUTPUT_TRANSPOSE_ORDER: same convention as
// cm_sdpa_opt_prefill.cm (cm_sdpa_opt_common.hpp) -- K/V orders apply identically to both the ring
// and current buffers (both are addressed via the same get_seq_pitch_bytes/get_head_byte_offset
// helpers, just with each source's own kv_len).
#include "cm_sdpa_common.hpp"
#include "cm_sdpa_opt_common.hpp"

namespace KERNEL_NAME {

#include "cm_sdpa_common.hpp"
#include "cm_sdpa_opt_common.hpp"

#ifndef SPARSE_BLOCK_SIZE
#define SPARSE_BLOCK_SIZE 128
#endif
static_assert(SPARSE_BLOCK_SIZE > 1, "cm_sdpa_opt_prefill_multisource.cm requires a sparse block mask (SPARSE_BLOCK_SIZE > 1)");

_GENX_MAIN_ void KERNEL_NAME(
    half* query [[type("svmptr_t")]],
    half* key_ring [[type("svmptr_t")]],
    half* value_ring [[type("svmptr_t")]],
    half* key_cur [[type("svmptr_t")]],
    half* value_cur [[type("svmptr_t")]],
    half* output [[type("svmptr_t")]],
    int q_len,
    int kv_len_ring,
    int kv_len_cur,
    // [B,Hq,num_q_blocks,num_k_blocks_ring+num_k_blocks_cur], row-major, 1 byte/block, 1=keep
    // 0=skip -- ring's blocks first, current's blocks second (see cm_sdpa_common.hpp's
    // sdpa_kernel_lsc_prefetch_2src doc comment). Q-block index is per q-head (not shared across
    // a GQA group), matching cm_sdpa_opt_prefill.cm's sparse_block_mask ABI exactly.
    bool* sparse_block_mask [[type("svmptr_t")]],
    int num_q_blocks,
    int num_k_blocks_ring,
    int num_k_blocks_cur) {
    constexpr int num_heads = CMFLA_NUM_HEADS;
    constexpr int num_kv_heads = CMFLA_NUM_KV_HEADS;
    constexpr int head_size = CMFLA_HEAD_SIZE;
    constexpr int group_size = num_heads / num_kv_heads;

    float q_prescale_rt = q_prescale;

    auto bh = cm_group_id(1);           // 0 .. batch*num_heads-1
    auto b = bh / num_heads;
    auto h = bh % num_heads;
    auto hkv = h / group_size;

    auto wg_id = cm_group_id(2);
    auto wg_local_id = cm_local_id(2);
    auto local_size = cm_local_size(2);
    int wg_seq_len = local_size * q_step;
    int q_start = wg_id * wg_seq_len + wg_local_id * q_step;

    uint q_seq_pitch = get_seq_pitch_bytes<Q_TRANSPOSE_ORDER>(q_len, num_heads, head_size);
    uint k_seq_pitch_ring = get_seq_pitch_bytes<K_TRANSPOSE_ORDER>(kv_len_ring, num_kv_heads, head_size);
    uint v_seq_pitch_ring = get_seq_pitch_bytes<V_TRANSPOSE_ORDER>(kv_len_ring, num_kv_heads, head_size);
    uint k_seq_pitch_cur = get_seq_pitch_bytes<K_TRANSPOSE_ORDER>(kv_len_cur, num_kv_heads, head_size);
    uint v_seq_pitch_cur = get_seq_pitch_bytes<V_TRANSPOSE_ORDER>(kv_len_cur, num_kv_heads, head_size);
    uint o_seq_pitch = get_seq_pitch_bytes<OUTPUT_TRANSPOSE_ORDER>(q_len, num_heads, head_size);

    uint q_batch_off = (uint)b * get_batch_byte_stride(q_len, num_heads, head_size);
    uint k_batch_off_ring = (uint)b * get_batch_byte_stride(kv_len_ring, num_kv_heads, head_size);
    uint v_batch_off_ring = (uint)b * get_batch_byte_stride(kv_len_ring, num_kv_heads, head_size);
    uint k_batch_off_cur = (uint)b * get_batch_byte_stride(kv_len_cur, num_kv_heads, head_size);
    uint v_batch_off_cur = (uint)b * get_batch_byte_stride(kv_len_cur, num_kv_heads, head_size);
    uint o_batch_off = (uint)b * get_batch_byte_stride(q_len, num_heads, head_size);

    uint q_off = q_batch_off + get_head_byte_offset<Q_TRANSPOSE_ORDER>(h, q_len, head_size)
                 + (uint)q_start * q_seq_pitch;
    uint k_off_ring = k_batch_off_ring + get_head_byte_offset<K_TRANSPOSE_ORDER>(hkv, kv_len_ring, head_size);
    uint v_off_ring = v_batch_off_ring + get_head_byte_offset<V_TRANSPOSE_ORDER>(hkv, kv_len_ring, head_size);
    uint k_off_cur = k_batch_off_cur + get_head_byte_offset<K_TRANSPOSE_ORDER>(hkv, kv_len_cur, head_size);
    uint v_off_cur = v_batch_off_cur + get_head_byte_offset<V_TRANSPOSE_ORDER>(hkv, kv_len_cur, head_size);
    uint o_off = o_batch_off + get_head_byte_offset<OUTPUT_TRANSPOSE_ORDER>(h, q_len, head_size)
                 + (uint)q_start * o_seq_pitch;

    int q_tokens = q_len - q_start;
    if (q_tokens <= 0) return;

    // sparse_block_mask row for this work-item's (batch,q_head,q_block), split at
    // num_k_blocks_ring into the two sources' own sub-ranges (see cm_sdpa_common.hpp's
    // sdpa_accumulate_kv_source: each source indexes `kv_base >> sb_shift` relative to its own
    // pointer, so the current source's pointer is pre-offset here by num_k_blocks_ring blocks).
    svmptr_t sparse_mask_ring = 0;
    svmptr_t sparse_mask_cur = 0;
    if (sparse_block_mask) {
        int q_block = q_start / SPARSE_BLOCK_SIZE;
        if (q_block < num_q_blocks) {
            int num_k_blocks_total = num_k_blocks_ring + num_k_blocks_cur;
            uint mask_row_off = (uint)((b * num_heads + h) * num_q_blocks + q_block) * (uint)num_k_blocks_total;
            sparse_mask_ring = reinterpret_cast<svmptr_t>((bool*)sparse_block_mask + mask_row_off);
            sparse_mask_cur = reinterpret_cast<svmptr_t>((bool*)sparse_block_mask + mask_row_off + (uint)num_k_blocks_ring);
        }
    }

    sdpa_kernel_lsc_prefetch_2src<num_heads, num_kv_heads, head_size, 16, SPARSE_BLOCK_SIZE>(
        wg_local_id,
        q_tokens,
        q_seq_pitch,
        reinterpret_cast<svmptr_t>((uint8_t*)query + q_off),
        reinterpret_cast<svmptr_t>((uint8_t*)output + o_off),
        kv_len_ring,
        k_seq_pitch_ring,
        v_seq_pitch_ring,
        reinterpret_cast<svmptr_t>((uint8_t*)key_ring + k_off_ring),
        reinterpret_cast<svmptr_t>((uint8_t*)value_ring + v_off_ring),
        sparse_mask_ring,
        kv_len_cur,
        k_seq_pitch_cur,
        v_seq_pitch_cur,
        reinterpret_cast<svmptr_t>((uint8_t*)key_cur + k_off_cur),
        reinterpret_cast<svmptr_t>((uint8_t*)value_cur + v_off_cur),
        sparse_mask_cur,
        o_seq_pitch,
        q_prescale_rt);
}

}  // namespace KERNEL_NAME
