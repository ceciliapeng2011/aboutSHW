//
// Two-source (ring + current) block-sparse SDPA prefill kernel: the CM-kernel mirror of the real
// OpenVINO BlockSparseAttention primitive's `input[1]=key_cache.<layer>` (ring, persistent) +
// `input[2]=k_new_f16` (current, this chunk's own new K/V) ABI -- see
// flashvsr_dit_kvcache_int8_3slot_fused_multisource_design_zh.md Sec 3.3/10.4. Ring and current
// are two INDEPENDENT device buffers, never concatenated by host or kernel; the inner tile loop
// (sdpa_kernel_lsc_prefetch_2src, in cm_sdpa_common.hpp) visits ring's tiles then current's tiles
// against one shared pair of online-softmax accumulators, which is numerically equivalent to one
// pass over concat(key_ring, key_cur).
//
// Deliberately narrower than cm_sdpa_opt_prefill.cm: no causal mask, no dense additive attn_mask,
// SPARSE_BLOCK_SIZE is always required (>1) -- FlashVSR's own self-attention never needs the first
// two, and a dual-source *dense* kernel has no behavior distinguishing it from the existing
// single-source one worth testing separately. See cm_sdpa_common.hpp's sdpa_accumulate_kv_source
// file-header comment for the full rationale.
//
// Q_TRANSPOSE_ORDER/K_TRANSPOSE_ORDER/V_TRANSPOSE_ORDER/OUTPUT_TRANSPOSE_ORDER: same convention as
// cm_sdpa_opt_prefill.cm (cm_sdpa_opt_common.hpp) -- K/V orders apply identically to both the ring
// and current buffers (both are addressed via the same get_seq_pitch_bytes/get_head_byte_offset
// helpers, just with each source's own kv_len).
//
// KV_RING_FP8E4M3 (default 0): when set, key_ring/value_ring are read as fp8e4m3-packed bytes (1
// byte/element) instead of plain half, decoded to half in-register right at DPAS time via a
// work-group-local SLM copy of the 256-entry decode LUT -- see cm_sdpa_common.hpp's
// hf8_e4m3_decode_to_f16_lut_slm/sdpa_accumulate_kv_source<...,KVElemT=uchar>, and this kernel's
// own cooperative LUT-fill block below (right after wg_local_id/local_size are computed, and
// BEFORE the q_tokens<=0 early-return, since its barrier must be reached by every lane). Only
// the ring source is ever affected; key_cur/value_cur always stay plain half (current is
// transient, quantizing it buys no persistent-memory win -- see
// flashvsr_dit_kvcache_int8_3slot_fused_multisource_design_zh.md Sec 3.1's identical rationale for
// the analogous int8 design). The physical ring buffer is then 1 byte/element, so its own
// pitch/offset must be computed at elem_size=sizeof(uchar) (see kv_ring_elem_size below) --
// current's pitch/offset are untouched (still implicitly sizeof(half) via the 1-arg template call).
//
// PERF: fp8 ring is NOT a speed win over plain half here -- measured ~3.2x SLOWER at FlashVSR's
// realistic steady-state shape (bench_sdpa_multisource.py), because this kernel's per-work-item
// (no SLM/barrier K/V sharing) design re-decodes the same K/V bytes independently in every one of
// a work-group's 16 lanes, unamortized -- see sdpa_accumulate_kv_source's lut_slm_base doc
// comment in cm_sdpa_common.hpp ("KNOWN REMAINING PERF GAP") for the full explanation and why
// closing it is out of scope for this deliberately simple/barrier-free kernel family. KV_RING_FP8E4M3's
// value here is the persistent-memory footprint halving (the real motivation, matching
// flashvsr_dit_kvcache_int8_3slot_fused_multisource_design_zh.md's ring-cache design), not latency.
#include "cm_sdpa_common.hpp"
#include "cm_sdpa_opt_common.hpp"

namespace KERNEL_NAME {

#include "cm_sdpa_common.hpp"
#include "cm_sdpa_opt_common.hpp"

#ifndef SPARSE_BLOCK_SIZE
#define SPARSE_BLOCK_SIZE 128
#endif
static_assert(SPARSE_BLOCK_SIZE > 1, "cm_sdpa_opt_prefill_multisource.cm requires a sparse block mask (SPARSE_BLOCK_SIZE > 1)");

#ifndef KV_RING_FP8E4M3
#define KV_RING_FP8E4M3 0
#endif

_GENX_MAIN_ void KERNEL_NAME(
    half* query [[type("svmptr_t")]],
    half* key_ring [[type("svmptr_t")]],
    half* value_ring [[type("svmptr_t")]],
    half* key_cur [[type("svmptr_t")]],
    half* value_cur [[type("svmptr_t")]],
    half* output [[type("svmptr_t")]],
    int q_len,
    int kv_len_ring,
    int kv_len_cur,
    // [B,Hq,num_q_blocks,num_k_blocks_ring+num_k_blocks_cur], row-major, 1 byte/block, 1=keep
    // 0=skip -- ring's blocks first, current's blocks second (see cm_sdpa_common.hpp's
    // sdpa_kernel_lsc_prefetch_2src doc comment). Q-block index is per q-head (not shared across
    // a GQA group), matching cm_sdpa_opt_prefill.cm's sparse_block_mask ABI exactly.
    bool* sparse_block_mask [[type("svmptr_t")]],
    int num_q_blocks,
    int num_k_blocks_ring,
    int num_k_blocks_cur
#if KV_RING_FP8E4M3
    // 256-entry half LUT, index == raw fp8e4m3 byte value (hf8_e4m3_ref.py's
    // build_hf8_decode_lut_f16) -- copied into a work-group-local SLM buffer once below (the
    // cooperative LUT fill), then gathered from there by hf8_e4m3_decode_to_f16_lut_slm. This
    // global pointer itself is only ever read during that one-time SLM fill, never gathered from
    // directly -- see cm_sdpa_opt_prefill.cm's identical KV_FP8E4M3 setup and
    // cm_sdpa_common.hpp's sdpa_accumulate_kv_source doc comment for why a per-call global gather
    // (this kernel's earlier approach) was measured catastrophically slow instead.
    , half* hf8_lut [[type("svmptr_t")]]
#endif
    ) {
    constexpr int num_heads = CMFLA_NUM_HEADS;
    constexpr int num_kv_heads = CMFLA_NUM_KV_HEADS;
    constexpr int head_size = CMFLA_HEAD_SIZE;
    constexpr int group_size = num_heads / num_kv_heads;

    float q_prescale_rt = q_prescale;

    auto bh = cm_group_id(1);           // 0 .. batch*num_heads-1
    auto b = bh / num_heads;
    auto h = bh % num_heads;
    auto hkv = h / group_size;

    auto wg_id = cm_group_id(2);
    auto wg_local_id = cm_local_id(2);
    auto local_size = cm_local_size(2);
    int wg_seq_len = local_size * q_step;
    int q_start = wg_id * wg_seq_len + wg_local_id * q_step;

#if KV_RING_FP8E4M3
    // Cooperative one-shot SLM fill for the 256-entry half decode LUT -- verbatim copy of
    // cm_sdpa_opt_prefill.cm's KV_FP8E4M3 cooperative LUT fill (see hf8_e4m3_decode_to_f16_lut_slm's
    // doc comment in cm_sdpa_common.hpp). MUST run, and its barrier MUST be reached, by EVERY lane
    // in the work-group -- including one with zero valid q_tokens -- so this runs before the
    // q_tokens<=0 early-return a few lines below: an unconditional per-lane return before a
    // barrier any sibling lane still needs to reach would deadlock the work-group (the exact
    // pitfall cm_sdpa_opt_prefill.cm's own KV_FP8E4M3 doc comment documents for its barrier-
    // pipelined K/V staging; this kernel has no barrier anywhere else, but the LUT fill introduces
    // exactly one, so the same rule applies).
    constexpr uint LUT_SLM_SIZE = 256 * sizeof(half);
    cm_slm_init(LUT_SLM_SIZE);
    uint slm_lut = cm_slm_alloc(LUT_SLM_SIZE);
    {
        svmptr_t hf8_lut_ptr = reinterpret_cast<svmptr_t>(hf8_lut);
        constexpr int LUT_CHUNK = 8;  // 8 half = 16 bytes/lane/iteration
        vector<uint, LUT_CHUNK> lane_iota;
        cmtl::cm_vector_assign(lane_iota.select_all(), 0, 1);  // 0,1,...,LUT_CHUNK-1
        for (int e = LUT_CHUNK * wg_local_id; e < 256; e += LUT_CHUNK * local_size) {
            vector<uint, LUT_CHUNK> idx = (uint)e + lane_iota;
            vector<uint, LUT_CHUNK> byte_offsets = idx * (uint)sizeof(half);
            vector<half, LUT_CHUNK> lut_chunk =
                cm_ptr_load<half, VectorSize::N1, DataSize::U16, CacheHint::Cached, CacheHint::Cached>(
                    reinterpret_cast<half*>(hf8_lut_ptr), byte_offsets);
            cm_slm_block_write(slm_lut, (int)(e * sizeof(half)), lut_chunk);
        }
    }
    cm_slm_fence(CM_LOCAL_BARRIER);
    cm_barrier();
#else
    uint slm_lut = 0;
#endif

    // Ring-only byte-size-per-element: 1 (uchar/fp8e4m3) when KV_RING_FP8E4M3, else sizeof(half)
    // (today's unchanged default) -- current's pitch/offset calls below deliberately keep using
    // the 1-arg template form, which still defaults to sizeof(half) regardless of this macro.
#if KV_RING_FP8E4M3
    constexpr int kv_ring_elem_size = sizeof(uchar);
#else
    constexpr int kv_ring_elem_size = sizeof(half);
#endif

    uint q_seq_pitch = get_seq_pitch_bytes<Q_TRANSPOSE_ORDER>(q_len, num_heads, head_size);
    uint k_seq_pitch_ring = get_seq_pitch_bytes<K_TRANSPOSE_ORDER, kv_ring_elem_size>(kv_len_ring, num_kv_heads, head_size);
    uint v_seq_pitch_ring = get_seq_pitch_bytes<V_TRANSPOSE_ORDER, kv_ring_elem_size>(kv_len_ring, num_kv_heads, head_size);
    uint k_seq_pitch_cur = get_seq_pitch_bytes<K_TRANSPOSE_ORDER>(kv_len_cur, num_kv_heads, head_size);
    uint v_seq_pitch_cur = get_seq_pitch_bytes<V_TRANSPOSE_ORDER>(kv_len_cur, num_kv_heads, head_size);
    uint o_seq_pitch = get_seq_pitch_bytes<OUTPUT_TRANSPOSE_ORDER>(q_len, num_heads, head_size);

    uint q_batch_off = (uint)b * get_batch_byte_stride(q_len, num_heads, head_size);
    uint k_batch_off_ring = (uint)b * get_batch_byte_stride(kv_len_ring, num_kv_heads, head_size, kv_ring_elem_size);
    uint v_batch_off_ring = (uint)b * get_batch_byte_stride(kv_len_ring, num_kv_heads, head_size, kv_ring_elem_size);
    uint k_batch_off_cur = (uint)b * get_batch_byte_stride(kv_len_cur, num_kv_heads, head_size);
    uint v_batch_off_cur = (uint)b * get_batch_byte_stride(kv_len_cur, num_kv_heads, head_size);
    uint o_batch_off = (uint)b * get_batch_byte_stride(q_len, num_heads, head_size);

    uint q_off = q_batch_off + get_head_byte_offset<Q_TRANSPOSE_ORDER>(h, q_len, head_size)
                 + (uint)q_start * q_seq_pitch;
    uint k_off_ring = k_batch_off_ring + get_head_byte_offset<K_TRANSPOSE_ORDER, kv_ring_elem_size>(hkv, kv_len_ring, head_size);
    uint v_off_ring = v_batch_off_ring + get_head_byte_offset<V_TRANSPOSE_ORDER, kv_ring_elem_size>(hkv, kv_len_ring, head_size);
    uint k_off_cur = k_batch_off_cur + get_head_byte_offset<K_TRANSPOSE_ORDER>(hkv, kv_len_cur, head_size);
    uint v_off_cur = v_batch_off_cur + get_head_byte_offset<V_TRANSPOSE_ORDER>(hkv, kv_len_cur, head_size);
    uint o_off = o_batch_off + get_head_byte_offset<OUTPUT_TRANSPOSE_ORDER>(h, q_len, head_size)
                 + (uint)q_start * o_seq_pitch;

    int q_tokens = q_len - q_start;
    if (q_tokens <= 0) return;

    // sparse_block_mask row for this work-item's (batch,q_head,q_block), split at
    // num_k_blocks_ring into the two sources' own sub-ranges (see cm_sdpa_common.hpp's
    // sdpa_accumulate_kv_source: each source indexes `kv_base >> sb_shift` relative to its own
    // pointer, so the current source's pointer is pre-offset here by num_k_blocks_ring blocks).
    svmptr_t sparse_mask_ring = 0;
    svmptr_t sparse_mask_cur = 0;
    if (sparse_block_mask) {
        int q_block = q_start / SPARSE_BLOCK_SIZE;
        if (q_block < num_q_blocks) {
            int num_k_blocks_total = num_k_blocks_ring + num_k_blocks_cur;
            uint mask_row_off = (uint)((b * num_heads + h) * num_q_blocks + q_block) * (uint)num_k_blocks_total;
            sparse_mask_ring = reinterpret_cast<svmptr_t>((bool*)sparse_block_mask + mask_row_off);
            sparse_mask_cur = reinterpret_cast<svmptr_t>((bool*)sparse_block_mask + mask_row_off + (uint)num_k_blocks_ring);
        }
    }

    sdpa_kernel_lsc_prefetch_2src<num_heads, num_kv_heads, head_size, 16, SPARSE_BLOCK_SIZE, (bool)KV_RING_FP8E4M3>(
        wg_local_id,
        q_tokens,
        q_seq_pitch,
        reinterpret_cast<svmptr_t>((uint8_t*)query + q_off),
        reinterpret_cast<svmptr_t>((uint8_t*)output + o_off),
        kv_len_ring,
        k_seq_pitch_ring,
        v_seq_pitch_ring,
        reinterpret_cast<svmptr_t>((uint8_t*)key_ring + k_off_ring),
        reinterpret_cast<svmptr_t>((uint8_t*)value_ring + v_off_ring),
        sparse_mask_ring,
        kv_len_cur,
        k_seq_pitch_cur,
        v_seq_pitch_cur,
        reinterpret_cast<svmptr_t>((uint8_t*)key_cur + k_off_cur),
        reinterpret_cast<svmptr_t>((uint8_t*)value_cur + v_off_cur),
        sparse_mask_cur,
        slm_lut,
        o_seq_pitch,
        q_prescale_rt);
}

}  // namespace KERNEL_NAME
