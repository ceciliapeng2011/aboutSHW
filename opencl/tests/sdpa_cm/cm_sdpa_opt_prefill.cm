//
// SDPA (scaled_dot_product_attention) CM prefill kernel with the same dense [B,H,S,D] ABI as
// OpenVINO's OCL sdpa_opt multi-token kernel (sdpa_gen_opt.cpp / sdpa_opt.cl), built on the same
// flash-attention body PagedAttention's CM prefill kernel uses (cm_attention_common.hpp, via
// flashattn/cm_sdpa_common.hpp's sdpa_kernel_lsc_prefetch -- reused unmodified here).
//
// Q_TRANSPOSE_ORDER/K_TRANSPOSE_ORDER/V_TRANSPOSE_ORDER/OUTPUT_TRANSPOSE_ORDER select between
// OCL SDPA's identity layout [B,H,S,D] (heads outer, TransposeSDPAMatcher's default) and the
// {0,2,1,3}-fused heads<->seq swap [B,S,H,D] (heads inner) -- the only two orders the OCL kernel
// itself supports (sdpa_gen_opt.cpp's OUTPUT_TRANSPOSE_ORDER_PRESENT assert). head_size stays
// innermost/contiguous either way, matching the transpose-fusion invariant.
//
// KV_CACHE_COMPRESSION (default 0=NONE, matches pageatten/test_pa.py's own
// KV_CACHE_COMPRESSION_{NONE,BY_TOKEN,BY_CHANNEL} enum/JIT-constant convention): when 1 or 2,
// key/value are read as int8-packed bytes (1 byte/element, affine uint8 quantization -- see
// cm_int8_kv_decode.hpp) instead of plain half, decoded to half once per work-group and staged
// through SLM -- calls cm_sdpa_common.hpp's sdpa_kernel_lsc instantiated with KVElemT=uchar instead
// of sdpa_kernel_lsc_prefetch. K is quantized BY_CHANNEL when ==2 (one scale/zp pair per 16-token
// sub-block per head_size channel) or BY_TOKEN when ==1 (one pair per token); V is always BY_TOKEN
// regardless of mode -- matches opencl/tests/pageatten/kv_cache_quant_utils.py's own K/V asymmetry
// exactly (see int8_kv_ref.py, the host-side oracle this wraps). Mirrors
// KV_CACHE_COMPRESSION's convention in cm_sdpa_opt_prefill_dualsource.cm, applied here to the
// single K/V source this kernel has (query and output stay plain half either way). The physical
// K/V buffer is then 1 byte/element, so its own pitch/offset must be computed at
// elem_size=sizeof(uchar) (see kv_elem_size below) -- Q/output pitch/offset calls below
// deliberately keep using the 1-arg template form, which still defaults to sizeof(half).
// Causal-only, no attn_mask (matches sdpa_kernel_lsc's own int8 scope). SPARSE_BLOCK_SIZE IS
// supported here (both 128 and 256) -- see sdpa_kernel_lsc's doc comment for the two-level
// skip-LOAD/skip-COMPUTE mask split SPARSE_BLOCK_SIZE==128 needs on top of 256's simpler
// single-mask case.
#include "cm_sdpa_common.hpp"
#include "cm_sdpa_opt_common.hpp"

namespace KERNEL_NAME {

#include "cm_sdpa_common.hpp"
#include "cm_sdpa_opt_common.hpp"

#ifndef HAS_ATTN_MASK_INPUT
#define HAS_ATTN_MASK_INPUT 0
#endif
#ifndef HAS_SCALE_INPUT
#define HAS_SCALE_INPUT 0
#endif
// XAttention 2nd-stage block-sparsity gate, mirroring pageatten/cm_pa_xe2.hpp's own
// SPARSE_BLOCK_SIZE convention: 1 (default) means "fully dense, no mask args at all" -- a
// no-op/bypass that leaves the non-sparse ABI (and codegen) completely unchanged. 128 or 256
// enables the sparse_block_mask-consuming path (must match the XAttention scoring pipeline's
// block size the mask was produced with).
#ifndef SPARSE_BLOCK_SIZE
#define SPARSE_BLOCK_SIZE 1
#endif
#ifndef KV_CACHE_COMPRESSION
#define KV_CACHE_COMPRESSION 0
#endif

_GENX_MAIN_ void KERNEL_NAME(
    half* query [[type("svmptr_t")]],
    half* key [[type("svmptr_t")]],
    half* value [[type("svmptr_t")]],
#if HAS_ATTN_MASK_INPUT
    half* attn_mask [[type("svmptr_t")]],  // [1,1,q_len,kv_len], additive, pre-scale units
#endif
#if HAS_SCALE_INPUT
    float scale,  // overrides CMFLA_SCALE_FACTOR when set
#endif
    half* output [[type("svmptr_t")]],
    int q_len,
    int kv_len
#if SPARSE_BLOCK_SIZE > 1
    // [B,Hq,num_q_blocks,num_k_blocks], row-major, 1 byte/block, 1=keep 0=skip -- a caller-supplied
    // block-table mask, algorithm-agnostic. Q-block index is per q-head (not shared across a GQA
    // group).
    , bool* sparse_block_mask [[type("svmptr_t")]]
    , int num_q_blocks
    , int num_k_blocks
#endif
#if KV_CACHE_COMPRESSION
    // Int8 dequant scale/zero-point tensors -- see cm_int8_kv_decode.hpp and int8_kv_ref.py (the
    // host-side encode reference). key_scale/key_zp are [kv_len/16, head_size] when
    // KV_CACHE_COMPRESSION==2 (BY_CHANNEL) or [kv_len] when ==1 (BY_TOKEN); value_scale/value_zp
    // are always [kv_len] (V is always BY_TOKEN).
    , half* key_scale [[type("svmptr_t")]]
    , half* key_zp [[type("svmptr_t")]]
    , half* value_scale [[type("svmptr_t")]]
    , half* value_zp [[type("svmptr_t")]]
#endif
    ) {
    constexpr int num_heads = CMFLA_NUM_HEADS;
    constexpr int num_kv_heads = CMFLA_NUM_KV_HEADS;
    constexpr int head_size = CMFLA_HEAD_SIZE;
    constexpr int group_size = num_heads / num_kv_heads;

#if HAS_SCALE_INPUT
#if CMFLA_Q_SCALED_BY_LOG2
    float q_prescale_rt = scale * log2e;
#else
    float q_prescale_rt = scale;
#endif
#else
    float q_prescale_rt = q_prescale;
#endif

    auto bh = cm_group_id(1);           // 0 .. batch*num_heads-1
    auto b = bh / num_heads;
    auto h = bh % num_heads;
    auto hkv = h / group_size;

    auto wg_id = cm_group_id(2);
    auto wg_local_id = cm_local_id(2);
    auto local_size = cm_local_size(2);
    int wg_seq_len = local_size * q_step;
    int q_start = wg_id * wg_seq_len + wg_local_id * q_step;

    // K/V-only byte-size-per-element: 1 (uchar/int8) when KV_CACHE_COMPRESSION, else sizeof(half)
    // (today's unchanged default) -- Q/output pitch/offset calls below deliberately keep using the
    // 1-arg template form, which still defaults to sizeof(half) regardless of this macro.
#if KV_CACHE_COMPRESSION
    constexpr int kv_elem_size = sizeof(uchar);
#else
    constexpr int kv_elem_size = sizeof(half);
#endif

    uint q_seq_pitch = get_seq_pitch_bytes<Q_TRANSPOSE_ORDER>(q_len, num_heads, head_size);
    uint k_seq_pitch = get_seq_pitch_bytes<K_TRANSPOSE_ORDER, kv_elem_size>(kv_len, num_kv_heads, head_size);
    uint v_seq_pitch = get_seq_pitch_bytes<V_TRANSPOSE_ORDER, kv_elem_size>(kv_len, num_kv_heads, head_size);
    uint o_seq_pitch = get_seq_pitch_bytes<OUTPUT_TRANSPOSE_ORDER>(q_len, num_heads, head_size);

    uint q_batch_off = (uint)b * get_batch_byte_stride(q_len, num_heads, head_size);
    uint k_batch_off = (uint)b * get_batch_byte_stride(kv_len, num_kv_heads, head_size, kv_elem_size);
    uint v_batch_off = (uint)b * get_batch_byte_stride(kv_len, num_kv_heads, head_size, kv_elem_size);
    uint o_batch_off = (uint)b * get_batch_byte_stride(q_len, num_heads, head_size);

    uint q_off = q_batch_off + get_head_byte_offset<Q_TRANSPOSE_ORDER>(h, q_len, head_size)
                 + (uint)q_start * q_seq_pitch;
    uint k_off = k_batch_off + get_head_byte_offset<K_TRANSPOSE_ORDER, kv_elem_size>(hkv, kv_len, head_size);
    uint v_off = v_batch_off + get_head_byte_offset<V_TRANSPOSE_ORDER, kv_elem_size>(hkv, kv_len, head_size);
    uint o_off = o_batch_off + get_head_byte_offset<OUTPUT_TRANSPOSE_ORDER>(h, q_len, head_size)
                 + (uint)q_start * o_seq_pitch;

    int q_tokens = q_len - q_start;
    int kv_stop = kv_len;
#if CMFLA_IS_CAUSAL
    // Causal: this WG's query tile never needs to look past its own last token.
    int causal_kv_stop = q_start + wg_seq_len;
    if (causal_kv_stop < kv_stop) kv_stop = causal_kv_stop;
#endif

    // NOTE: the early "this lane has no valid query tokens" return is NOT done here anymore --
    // see the KV_CACHE_COMPRESSION branch below for why, and cm_pa_xe2.hpp's pa_lsc_u8/
    // pa_kernel_lsc_prefetch_f16 (+ its "Threads with zero valid query tokens can early exit if
    // there is no barrier" comment) for the architectural precedent this now mirrors: a
    // barrier-free kernel is free to early-return per-lane (done just below the #else, right
    // before sdpa_kernel_lsc_prefetch), but a barrier-pipelined one (sdpa_kernel_lsc, KVElemT=uchar)
    // is NOT -- every lane in a work-group must keep calling into it so every lane reaches the same
    // cm_sbarrier/cm_fence sequence, even lanes with zero (or negative) q_tokens. Returning here
    // unconditionally used to deadlock any work-group whose Q range isn't an exact multiple of
    // wg_seq_len: the trailing lanes (q_tokens<=0) would return right here without ever entering
    // sdpa_kernel_lsc, while their sibling lanes in the same work-group (q_tokens>0) would go
    // on to hit its barriers -- confirmed to hang real hardware (reproduced on both the
    // block-sparse and the plain dense KV_CACHE_COMPRESSION path, since neither ever checked
    // q_tokens again after this point). sdpa_kernel_lsc itself already clamps q_tokens_left to
    // [0,q_step] and only skips its own Q-load / final O-store for an inactive lane -- it never
    // skips the barrier pipeline -- so it's always safe to call unconditionally.

#if HAS_ATTN_MASK_INPUT
    // attn_mask is [1,1,q_len,kv_len] -- shared across batch/heads, row-major with kv_len
    // contiguous, but the per-row PITCH is padded up to a multiple of 8 half-elements (16
    // bytes): the LSC 2D block descriptor requires its pitch to be 16-byte aligned, which a
    // raw kv_len*sizeof(half) stride isn't guaranteed to be (e.g. kv_len=100 -> 200 bytes,
    // not a multiple of 16). The host-side buffer must be allocated with this same padded
    // row stride (extra tail columns are never read: the descriptor's surface WIDTH bound
    // stays the true kv_len, so only real columns are ever touched).
    uint mask_pitch_bytes = (uint)((kv_len + 7) / 8 * 8) * sizeof(half);
    uint mask_off = (uint)q_start * mask_pitch_bytes;
    svmptr_t mask_ptr = reinterpret_cast<svmptr_t>((uint8_t*)attn_mask + mask_off);
#else
    uint mask_pitch_bytes = 0;
    svmptr_t mask_ptr = 0;
#endif

#if SPARSE_BLOCK_SIZE > 1
    // sparse_block_mask row for this work-item's (batch,q_head,q_block) -- q_start is always a
    // multiple of q_step(16), which divides both allowed SPARSE_BLOCK_SIZE values (128/256), so
    // this Q tile never straddles a block boundary.
    svmptr_t sparse_mask_ptr = 0;
    if (sparse_block_mask) {
        int q_block = q_start / SPARSE_BLOCK_SIZE;
        if (q_block < num_q_blocks) {
            uint mask_row_off = (uint)((b * num_heads + h) * num_q_blocks + q_block) * (uint)num_k_blocks;
            sparse_mask_ptr = reinterpret_cast<svmptr_t>((bool*)sparse_block_mask + mask_row_off);
        }
    }
#else
    svmptr_t sparse_mask_ptr = 0;
#endif

#if KV_CACHE_COMPRESSION
    // Decode-once-per-work-group path: see cm_sdpa_common.hpp's sdpa_kernel_lsc doc comment
    // (KVElemT=uchar instantiation). Causal-only, no attn_mask -- matches that function's own int8
    // scope (a focused perf experiment, not a feature-parity replacement for
    // sdpa_kernel_lsc_prefetch).
    static_assert(!HAS_ATTN_MASK_INPUT, "KV_CACHE_COMPRESSION doesn't support attn_mask -- sdpa_kernel_lsc<..., uchar> has no attn_mask path");
    // Block-sparsity IS supported at both allowed SPARSE_BLOCK_SIZE values (128, 256) -- see
    // sdpa_kernel_lsc's doc comment for the full two-level (skip-LOAD vs skip-COMPUTE)
    // rationale SPARSE_BLOCK_SIZE==128 needs on top of SPARSE_BLOCK_SIZE==256's simpler single-mask
    // case. Any OTHER value is a hard compile error here, not silently wrong.
    static_assert(SPARSE_BLOCK_SIZE == 1 || SPARSE_BLOCK_SIZE == 128 || SPARSE_BLOCK_SIZE == 256,
                  "KV_CACHE_COMPRESSION's block-sparsity support requires SPARSE_BLOCK_SIZE in {128, "
                  "256} -- any other value would either misalign with the barrier-pipelined "
                  "work-group's 256-token span or fail to divide it evenly");

    constexpr int padded_head_size = (head_size + 16 - 1) / 16 * 16;
    // Quad-buffered (see sdpa_kernel_lsc's load_slm_KV pipeline) -- same sizing convention as
    // cm_sdpa_vlen.cm's non-prefetch sdpa_kernel_lsc call site. No LUT SLM allocation needed --
    // int8 affine decode reads scale/zp directly from SVM inside load_slm_KV (cm_int8_kv_decode.hpp),
    // same as K/V data itself.
    constexpr uint K_SLM_SIZE = (4 * kv_step * padded_head_size * sizeof(half));
    constexpr uint V_SLM_SIZE = (4 * kv_step * padded_head_size * sizeof(half));
    cm_slm_init(K_SLM_SIZE + V_SLM_SIZE);
    auto slm_K = cm_slm_alloc(K_SLM_SIZE);
    auto slm_V = cm_slm_alloc(V_SLM_SIZE);

    // Scale/zp tensors are always a fixed, TRANSPOSE_ORDER-independent [B, num_kv_heads, ...,
    // head_size-or-1] layout (see int8_kv_ref.py) -- unlike key/value's own byte layout, there's no
    // meaningful "swapped" convention for quantization metadata, so this is plain [B,Hkv,...]
    // element arithmetic, not get_seq_pitch_bytes/get_head_byte_offset. K is [num_sub_blocks,
    // head_size] per (b,hkv) when BY_CHANNEL, else [kv_len]; V is always [kv_len].
#if KV_CACHE_COMPRESSION == 2
    int num_k_sub_blocks = (kv_len + 15) / 16;
    uint k_meta_off = ((uint)b * num_kv_heads + (uint)hkv) * (uint)num_k_sub_blocks * (uint)head_size;
#else
    uint k_meta_off = ((uint)b * num_kv_heads + (uint)hkv) * (uint)kv_len;
#endif
    uint v_meta_off = ((uint)b * num_kv_heads + (uint)hkv) * (uint)kv_len;

    // sdpa_kernel_lsc's load_slm_KV pipeline synchronizes the whole work-group via
    // cm_sbarrier/cm_fence, so every lane MUST run the exact same number of kv_pos loop
    // iterations -- unlike sdpa_kernel_lsc_prefetch below (no barriers, no SLM sharing), which is
    // safe with the per-lane `kv_stop` computed above (causal_kv_stop derived from this work-item's
    // own q_start, which varies by wg_local_id). Reusing that per-lane kv_stop here would make
    // lanes with a smaller causal extent exit the loop (and stop reaching the barriers) before
    // lanes with a larger one are done, deadlocking the work-group as soon as a WG's Q range spans
    // more than one wg_local_id's worth of causal depth (i.e. as soon as a sequence needs more than
    // one Q work-group -- this is confirmed on real hardware: it hangs for seq_len=2048 but not for
    // the single-WG shapes test_sdpa_prefill_int8.py's SLM tests use). Recompute a work-group-uniform
    // bound instead, from wg_id (not wg_local_id) -- the LAST lane's causal extent -- so every lane
    // runs the same iteration count; each lane's own tighter causal mask (causal_left, derived from
    // its own q_start, computed inside sdpa_kernel_lsc) still correctly zeroes out whatever
    // extra tail this over-extension computes for it, exactly like sdpa_kernel_lsc_prefetch's own
    // per-sub-tile causal_left masking.
    int kv_stop_wg = kv_len;
#if CMFLA_IS_CAUSAL
    int wg_q_end = wg_id * wg_seq_len + wg_seq_len;
    if (wg_q_end < kv_stop_wg) kv_stop_wg = wg_q_end;
#endif

#if SPARSE_BLOCK_SIZE == 128
    // The two q_block rows (q_block=2*wg_id and 2*wg_id+1) this work-group's 256-token span
    // actually covers -- computed from wg_id (NOT q_start), so every lane in the work-group
    // derives the exact same two pointers. Only used for sdpa_kernel_lsc's work-group-uniform
    // skip-LOAD decision; see that function's doc comment for the full rationale. hi stays 0 (never
    // dereferenced) when this work-group's span has only one valid q_block left (q_len not a
    // multiple of 256).
    svmptr_t sparse_mask_wg_lo_ptr = 0, sparse_mask_wg_hi_ptr = 0;
    if (sparse_block_mask) {
        int wg_q_block_lo = wg_id * (wg_seq_len / SPARSE_BLOCK_SIZE);
        int wg_q_block_hi = wg_q_block_lo + 1;
        if (wg_q_block_lo < num_q_blocks) {
            uint off_lo = (uint)((b * num_heads + h) * num_q_blocks + wg_q_block_lo) * (uint)num_k_blocks;
            sparse_mask_wg_lo_ptr = reinterpret_cast<svmptr_t>((bool*)sparse_block_mask + off_lo);
        }
        if (wg_q_block_hi < num_q_blocks) {
            uint off_hi = (uint)((b * num_heads + h) * num_q_blocks + wg_q_block_hi) * (uint)num_k_blocks;
            sparse_mask_wg_hi_ptr = reinterpret_cast<svmptr_t>((bool*)sparse_block_mask + off_hi);
        }
    }
#else
    svmptr_t sparse_mask_wg_lo_ptr = 0, sparse_mask_wg_hi_ptr = 0;
#endif

    sdpa_kernel_lsc<(bool)CMFLA_IS_CAUSAL, num_heads, num_kv_heads, head_size, 0, SPARSE_BLOCK_SIZE, uchar,
                    KV_CACHE_COMPRESSION == 2>(
        slm_K,
        slm_V,
        wg_local_id,
        local_size,
        q_start,
        kv_stop_wg,
        q_tokens,
        kv_stop_wg,
        q_seq_pitch,
        k_seq_pitch,
        v_seq_pitch,
        reinterpret_cast<svmptr_t>((uint8_t*)query + q_off),
        reinterpret_cast<svmptr_t>((uint8_t*)key + k_off),
        reinterpret_cast<svmptr_t>((uint8_t*)value + v_off),
        reinterpret_cast<svmptr_t>((uint8_t*)output + o_off),
        o_seq_pitch,
        reinterpret_cast<svmptr_t>(key_scale + k_meta_off),
        reinterpret_cast<svmptr_t>(key_zp + k_meta_off),
        reinterpret_cast<svmptr_t>(value_scale + v_meta_off),
        reinterpret_cast<svmptr_t>(value_zp + v_meta_off),
        // sparse_mask_ptr: this work-item's own row (already WG-uniform at SPARSE_BLOCK_SIZE==256,
        // genuinely per-lane at SPARSE_BLOCK_SIZE==128 -- see sdpa_kernel_lsc's doc comment).
        // Used for skip-COMPUTE in both cases (and also skip-LOAD at 256, where the two decisions
        // coincide).
        sparse_mask_ptr,
        // sparse_mask_wg_lo/hi_ptr: only non-zero (and only ever read) at SPARSE_BLOCK_SIZE==128 --
        // see above.
        sparse_mask_wg_lo_ptr,
        sparse_mask_wg_hi_ptr);
#else
    // No SLM/barrier sharing in this path (every lane decodes independently), so an inactive lane
    // (q_tokens<=0) is free to early-exit here without stranding any sibling lane mid-barrier --
    // matches cm_pa_xe2.hpp's pa_kernel_lsc_prefetch_f16's identical early-return for its own
    // barrier-free (!enable_head_size_partition) configuration.
    if (q_tokens <= 0) return;

    sdpa_kernel_lsc_prefetch<(bool)CMFLA_IS_CAUSAL, num_heads, num_kv_heads, head_size, 0, 16,
                             (bool)HAS_ATTN_MASK_INPUT, SPARSE_BLOCK_SIZE>(
        wg_local_id,
        q_start,
        kv_stop,
        q_tokens,
        kv_stop,
        q_seq_pitch,
        k_seq_pitch,
        v_seq_pitch,
        reinterpret_cast<svmptr_t>((uint8_t*)query + q_off),
        reinterpret_cast<svmptr_t>((uint8_t*)key + k_off),
        reinterpret_cast<svmptr_t>((uint8_t*)value + v_off),
        reinterpret_cast<svmptr_t>((uint8_t*)output + o_off),
        o_seq_pitch,
        q_prescale_rt,
        mask_ptr,
        mask_pitch_bytes,
        sparse_mask_ptr);
#endif
}

}  // namespace KERNEL_NAME
