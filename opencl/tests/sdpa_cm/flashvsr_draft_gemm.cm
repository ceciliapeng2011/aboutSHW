//
// On-device stage 1/2 of FlashVSR's generate_draft_block_mask (see
// FlashVSR/diffsynth/models/wan_video_dit.py:116-153 and
// sdpa_cm/flashvsr_mask_reference.py for the vendored torch ground truth):
//   flashvsr_pool         -- mean-pool a windowed [num_windows,WINDOW_TOKENS,NUM_HEADS*HEAD_DIM]
//                            half tensor over the WINDOW_TOKENS dim, per head -> pooled
//                            [num_windows,NUM_HEADS,HEAD_DIM] half. Bandwidth-bound: reads the
//                            full windowed Q/K, same order of bytes as the main attention op
//                            itself. Called once for Q, once for K.
//   flashvsr_score_softmax -- block-level QK^T on the pooled vectors, scaled by 1/sqrt(HEAD_DIM),
//                            plus the tiled static local-spatial-window additive mask
//                            (build_local_block_mask_shifted_vec_normal_slide's output), fused
//                            with the row-wise softmax that used to be a separate
//                            flashvsr_softmax kernel launch (flashvsr_draft_topk.cm). The
//                            score-computing loop already visits every element of the row once
//                            while computing the dot product, so it tracks a running row-max in
//                            that same pass for free -- eliminating softmax's dedicated max-scan
//                            pass entirely (same trick as x_attn/estimate.hpp's GEMM-output ->
//                            online-softmax fusion). Net: 4 row-touches across 2 kernel launches
//                            (old flashvsr_score + flashvsr_softmax) drop to 3 row-touches in 1
//                            launch. Output is half probabilities (half chosen so the top-k step
//                            in flashvsr_draft_topk.cm can treat each value's raw bit pattern as
//                            a monotonic sort key directly).
//
#include <cm/cm.h>
#include <cm/cmtl.h>

#ifndef ATTR
#define ATTR [[type("svmptr_t")]]
#endif

namespace KERNEL_NAME {

#ifndef NUM_HEADS
#define NUM_HEADS 12
#endif
#ifndef HEAD_DIM
#define HEAD_DIM 128
#endif
#ifndef WINDOW_TOKENS
#define WINDOW_TOKENS 128
#endif

// windowed: [num_windows, WINDOW_TOKENS, NUM_HEADS*HEAD_DIM] half, contiguous (WindowPartition3D's
// own output layout -- no host-side reshuffling needed).
// pooled:   [num_windows, NUM_HEADS, HEAD_DIM] half.
// GWS: [num_windows, NUM_HEADS, 1], LWS: [1,1,1].
extern "C" _GENX_MAIN_ void flashvsr_pool(
    half* windowed ATTR,
    half* pooled ATTR) {
    constexpr uint D_full = NUM_HEADS * HEAD_DIM;
    uint w = cm_group_id(0);
    uint h = cm_group_id(1);

    uint row_base_elems = w * (uint)WINDOW_TOKENS * D_full + h * (uint)HEAD_DIM;

    vector<float, HEAD_DIM> acc = 0;
    for (uint t = 0; t < WINDOW_TOKENS; t++) {
        vector<half, HEAD_DIM> row;
        row.format<int>() = cm_ptr_load<int, HEAD_DIM / 2>((int*)windowed, (row_base_elems + t * D_full) * (uint)sizeof(half));
        vector<float, HEAD_DIM> row_f = row;
        acc += row_f;
    }
    vector<half, HEAD_DIM> out = acc * (1.0f / (float)WINDOW_TOKENS);

    uint out_off_elems = (w * (uint)NUM_HEADS + h) * (uint)HEAD_DIM;
    cm_ptr_store<int, HEAD_DIM / 2>((int*)pooled, out_off_elems * (uint)sizeof(half), out.format<int>());
}

// pooled_q: [num_q_windows, NUM_HEADS, HEAD_DIM] half.
// pooled_k: [num_k_windows, NUM_HEADS, HEAD_DIM] half.
// local_mask: [spatial_windows, spatial_windows] uint8 (1=keep/0=masked), from
//   build_local_block_mask_shifted_vec_normal_slide -- static per (h,w,local_range), tiled here
//   across every (Q-temporal-group, K-temporal-group) pair via modulo-spatial-window addressing
//   (l % spatial_windows, m % spatial_windows), matching generate_draft_block_mask's
//   `repeat(repeat_len,1,repeat_num,1)` tiling exactly without materializing the full [l,m] mask.
// raw_scores: [NUM_HEADS, num_q_windows, num_k_windows] float, scratch -- this kernel's own
//   inter-pass working buffer (still needed since num_k_windows is runtime-sized and can't live
//   in registers/a fixed-size vector); not read by any caller.
// probs: [NUM_HEADS, num_q_windows, num_k_windows] half, softmax output (always >= 0).
// GWS: [num_q_windows, NUM_HEADS, 1], LWS: [1,1,1].
extern "C" _GENX_MAIN_ void flashvsr_score_softmax(
    half* pooled_q ATTR,
    half* pooled_k ATTR,
    uchar* local_mask ATTR,
    float* raw_scores ATTR,
    half* probs ATTR,
    int num_q_windows,
    int num_k_windows,
    int spatial_windows,
    float scale) {
    constexpr float log2e = 1.4426950408889634f;
    uint l = cm_group_id(0);
    uint h = cm_group_id(1);

    vector<half, HEAD_DIM> qv;
    qv.format<int>() = cm_ptr_load<int, HEAD_DIM / 2>((int*)pooled_q, (l * (uint)NUM_HEADS + h) * (uint)HEAD_DIM * (uint)sizeof(half));
    vector<float, HEAD_DIM> qv_f = qv;

    uint l_spatial = l % (uint)spatial_windows;
    uint mask_row_off = l_spatial * (uint)spatial_windows;

    uint out_row_off = (h * (uint)num_q_windows + l) * (uint)num_k_windows;

    // Pass 1: dot product + local mask (unchanged math from the old flashvsr_score), also
    // tracking a running row_max for free in this same loop. At only ~0.5% of compute
    // roofline (see bench_flashvsr_mask.py), this loop is dominated by per-iteration scalar
    // overhead (loop increment/compare, modulo, mask branch) rather than the dot product
    // itself -- 4x unrolled here so that overhead is amortized across 4 independent K-rows'
    // worth of work instead of paid once per row.
    constexpr int UNROLL = 4;
    float row_max = -3.0e38f;
    int m = 0;
    for (; m + UNROLL <= num_k_windows; m += UNROLL) {
        vector<half, HEAD_DIM> kv0, kv1, kv2, kv3;
        kv0.format<int>() = cm_ptr_load<int, HEAD_DIM / 2>((int*)pooled_k, ((uint)(m + 0) * (uint)NUM_HEADS + h) * (uint)HEAD_DIM * (uint)sizeof(half));
        kv1.format<int>() = cm_ptr_load<int, HEAD_DIM / 2>((int*)pooled_k, ((uint)(m + 1) * (uint)NUM_HEADS + h) * (uint)HEAD_DIM * (uint)sizeof(half));
        kv2.format<int>() = cm_ptr_load<int, HEAD_DIM / 2>((int*)pooled_k, ((uint)(m + 2) * (uint)NUM_HEADS + h) * (uint)HEAD_DIM * (uint)sizeof(half));
        kv3.format<int>() = cm_ptr_load<int, HEAD_DIM / 2>((int*)pooled_k, ((uint)(m + 3) * (uint)NUM_HEADS + h) * (uint)HEAD_DIM * (uint)sizeof(half));

        float dot0 = cm_sum<float>(qv_f * vector<float, HEAD_DIM>(kv0));
        float dot1 = cm_sum<float>(qv_f * vector<float, HEAD_DIM>(kv1));
        float dot2 = cm_sum<float>(qv_f * vector<float, HEAD_DIM>(kv2));
        float dot3 = cm_sum<float>(qv_f * vector<float, HEAD_DIM>(kv3));

        float score0 = dot0 * scale;
        float score1 = dot1 * scale;
        float score2 = dot2 * scale;
        float score3 = dot3 * scale;

        uint m0_spatial = (uint)(m + 0) % (uint)spatial_windows;
        uint m1_spatial = (uint)(m + 1) % (uint)spatial_windows;
        uint m2_spatial = (uint)(m + 2) % (uint)spatial_windows;
        uint m3_spatial = (uint)(m + 3) % (uint)spatial_windows;

        if (!local_mask[mask_row_off + m0_spatial]) score0 = -1.0e9f;
        if (!local_mask[mask_row_off + m1_spatial]) score1 = -1.0e9f;
        if (!local_mask[mask_row_off + m2_spatial]) score2 = -1.0e9f;
        if (!local_mask[mask_row_off + m3_spatial]) score3 = -1.0e9f;

        raw_scores[out_row_off + (uint)(m + 0)] = score0;
        raw_scores[out_row_off + (uint)(m + 1)] = score1;
        raw_scores[out_row_off + (uint)(m + 2)] = score2;
        raw_scores[out_row_off + (uint)(m + 3)] = score3;

        row_max = cm_max<float>(row_max, score0);
        row_max = cm_max<float>(row_max, score1);
        row_max = cm_max<float>(row_max, score2);
        row_max = cm_max<float>(row_max, score3);
    }
    for (; m < num_k_windows; m++) {
        vector<half, HEAD_DIM> kv;
        kv.format<int>() = cm_ptr_load<int, HEAD_DIM / 2>((int*)pooled_k, ((uint)m * (uint)NUM_HEADS + h) * (uint)HEAD_DIM * (uint)sizeof(half));
        vector<float, HEAD_DIM> kv_f = kv;
        vector<float, HEAD_DIM> prod = qv_f * kv_f;
        float dot = cm_sum<float>(prod);
        float score = dot * scale;

        uint m_spatial = (uint)m % (uint)spatial_windows;
        uchar keep = local_mask[mask_row_off + m_spatial];
        if (!keep) score = -1.0e9f;

        raw_scores[out_row_off + (uint)m] = score;
        row_max = cm_max<float>(row_max, score);
    }

    // Pass 2: exp + accumulate sum (unchanged from the old flashvsr_softmax's 2nd pass).
    float sum = 0.0f;
    for (int m = 0; m < num_k_windows; m++) {
        float v = raw_scores[out_row_off + (uint)m];
        float e = cm_exp((v - row_max) * log2e); // cm_exp == exp2, so this is exp(v - row_max)
        sum += e;
        raw_scores[out_row_off + (uint)m] = e;
    }

    // Pass 3: normalize (unchanged from the old flashvsr_softmax's 3rd pass).
    float inv_sum = 1.0f / sum;
    for (int m = 0; m < num_k_windows; m++) {
        float e = raw_scores[out_row_off + (uint)m];
        probs[out_row_off + (uint)m] = (half)(e * inv_sum);
    }
}

}  // namespace KERNEL_NAME
