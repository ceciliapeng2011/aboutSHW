//
// On-device stage 1/2 of FlashVSR's generate_draft_block_mask (see
// FlashVSR/diffsynth/models/wan_video_dit.py:116-153 and
// sdpa_cm/flashvsr_mask_reference.py for the vendored torch ground truth):
//   flashvsr_pool  -- mean-pool a windowed [num_windows,WINDOW_TOKENS,NUM_HEADS*HEAD_DIM] half
//                     tensor over the WINDOW_TOKENS dim, per head -> pooled
//                     [num_windows,NUM_HEADS,HEAD_DIM] half. Bandwidth-bound: reads the full
//                     windowed Q/K, same order of bytes as the main attention op itself.
//                     Called once for Q, once for K.
//   flashvsr_score -- block-level QK^T on the pooled vectors, scaled by 1/sqrt(HEAD_DIM), plus
//                     the tiled static local-spatial-window additive mask
//                     (build_local_block_mask_shifted_vec_normal_slide's output). Tiny compute
//                     (pooled vectors only); output is pre-softmax raw scores, softmax itself
//                     lives in flashvsr_draft_topk.cm (needs the full row before it can start).
//
#include <cm/cm.h>
#include <cm/cmtl.h>

#ifndef ATTR
#define ATTR [[type("svmptr_t")]]
#endif

namespace KERNEL_NAME {

#ifndef NUM_HEADS
#define NUM_HEADS 12
#endif
#ifndef HEAD_DIM
#define HEAD_DIM 128
#endif
#ifndef WINDOW_TOKENS
#define WINDOW_TOKENS 128
#endif

// windowed: [num_windows, WINDOW_TOKENS, NUM_HEADS*HEAD_DIM] half, contiguous (WindowPartition3D's
// own output layout -- no host-side reshuffling needed).
// pooled:   [num_windows, NUM_HEADS, HEAD_DIM] half.
// GWS: [num_windows, NUM_HEADS, 1], LWS: [1,1,1].
extern "C" _GENX_MAIN_ void flashvsr_pool(
    half* windowed ATTR,
    half* pooled ATTR) {
    constexpr uint D_full = NUM_HEADS * HEAD_DIM;
    uint w = cm_group_id(0);
    uint h = cm_group_id(1);

    uint row_base_elems = w * (uint)WINDOW_TOKENS * D_full + h * (uint)HEAD_DIM;

    vector<float, HEAD_DIM> acc = 0;
    for (uint t = 0; t < WINDOW_TOKENS; t++) {
        vector<half, HEAD_DIM> row;
        row.format<int>() = cm_ptr_load<int, HEAD_DIM / 2>((int*)windowed, (row_base_elems + t * D_full) * (uint)sizeof(half));
        vector<float, HEAD_DIM> row_f = row;
        acc += row_f;
    }
    vector<half, HEAD_DIM> out = acc * (1.0f / (float)WINDOW_TOKENS);

    uint out_off_elems = (w * (uint)NUM_HEADS + h) * (uint)HEAD_DIM;
    cm_ptr_store<int, HEAD_DIM / 2>((int*)pooled, out_off_elems * (uint)sizeof(half), out.format<int>());
}

// pooled_q: [num_q_windows, NUM_HEADS, HEAD_DIM] half.
// pooled_k: [num_k_windows, NUM_HEADS, HEAD_DIM] half.
// local_mask: [spatial_windows, spatial_windows] uint8 (1=keep/0=masked), from
//   build_local_block_mask_shifted_vec_normal_slide -- static per (h,w,local_range), tiled here
//   across every (Q-temporal-group, K-temporal-group) pair via modulo-spatial-window addressing
//   (l % spatial_windows, m % spatial_windows), matching generate_draft_block_mask's
//   `repeat(repeat_len,1,repeat_num,1)` tiling exactly without materializing the full [l,m] mask.
// raw_scores: [NUM_HEADS, num_q_windows, num_k_windows] float, output (pre-softmax).
// GWS: [num_q_windows, NUM_HEADS, 1], LWS: [1,1,1].
extern "C" _GENX_MAIN_ void flashvsr_score(
    half* pooled_q ATTR,
    half* pooled_k ATTR,
    uchar* local_mask ATTR,
    float* raw_scores ATTR,
    int num_q_windows,
    int num_k_windows,
    int spatial_windows,
    float scale) {
    uint l = cm_group_id(0);
    uint h = cm_group_id(1);

    vector<half, HEAD_DIM> qv;
    qv.format<int>() = cm_ptr_load<int, HEAD_DIM / 2>((int*)pooled_q, (l * (uint)NUM_HEADS + h) * (uint)HEAD_DIM * (uint)sizeof(half));
    vector<float, HEAD_DIM> qv_f = qv;

    uint l_spatial = l % (uint)spatial_windows;
    uint mask_row_off = l_spatial * (uint)spatial_windows;

    uint out_row_off = (h * (uint)num_q_windows + l) * (uint)num_k_windows;

    for (int m = 0; m < num_k_windows; m++) {
        vector<half, HEAD_DIM> kv;
        kv.format<int>() = cm_ptr_load<int, HEAD_DIM / 2>((int*)pooled_k, ((uint)m * (uint)NUM_HEADS + h) * (uint)HEAD_DIM * (uint)sizeof(half));
        vector<float, HEAD_DIM> kv_f = kv;
        vector<float, HEAD_DIM> prod = qv_f * kv_f;
        float dot = cm_sum<float>(prod);
        float score = dot * scale;

        uint m_spatial = (uint)m % (uint)spatial_windows;
        uchar keep = local_mask[mask_row_off + m_spatial];
        if (!keep) score = -1.0e9f;

        raw_scores[out_row_off + (uint)m] = score;
    }
}

}  // namespace KERNEL_NAME
